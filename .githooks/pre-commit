#!/bin/sh
set -eu

root=$(git rev-parse --show-toplevel)
cd "$root"

if ! command -v debtmap >/dev/null 2>&1; then
    echo "pre-commit: debtmap is required; install it with cargo install debtmap" >&2
    exit 127
fi

debtmap config check --config .debtmap.toml
cargo fmt --all -- --check
cargo clippy --all-targets --all-features -- -D warnings
cargo test --all-targets -- --test-threads=1

exec debtmap validate . --config .debtmap.toml --format terminal
